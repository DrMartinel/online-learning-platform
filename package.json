{
  "name": "online-learning-platform",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "backend:build": "npm run build --prefix backend",
    "backend:start": "npm start --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "dev": "docker compose -f docker-compose.dev.yml up --build -d && npm run dev:logs",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f app backend",
    "dev:reset": "docker compose -f docker-compose.dev.yml down -v --remove-orphans && npm run dev:volume-reset && npm run dev",
    "dev:volume-reset": "docker run --rm -v \"$PWD/volumes:/volumes\" alpine rm -rf /volumes/db/data /volumes/storage",
    "build": "docker compose -f docker-compose.yml build",
    "start": "docker compose -f docker-compose.yml up -d",
    "stop": "docker compose -f docker-compose.yml down",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}