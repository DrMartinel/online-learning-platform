echo "Running pre-commit hook..."

echo "Checking backend code coverage (must be >= 70%)..."
cd backend && pnpm run test

if [ $? -ne 0 ]; then
  echo "Error: Tests failed or code coverage is below 70% threshold!"
  echo "Please run 'pnpm run test' locally in the backend folder to see detailed reports."
  exit 1
fi

echo "Pre-commit hook passed!"
exit 0
